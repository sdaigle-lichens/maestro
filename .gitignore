# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Build output
out
dist

# Turborepo — local task cache and daemon state. The cache is content-addressed tarballs of the
# very build output ignored above (dist/, out/), keyed by a hash of the lockfile, env and
# platform, so it is worthless on any other machine and CI keeps its own.
.turbo

# pnpm
.pnpm-store/
.pnpm-debug.log*

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.DS_Store

# TanStack Router's generated route tree cache
.tanstack/
# Maestro ephemeral session state — recreated as needed, never committed
**/.claude/maestro_session.json
**/.claude/maestro_session.log.jsonl
**/.claude/maestro_session_tasks.json
**/.claude/channels/
**/.claude/maestro_sessions/
