  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "check:sandbox": "node scripts/check-electron-sandbox.mjs",
    "dev": "node scripts/check-electron-sandbox.mjs && electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check": "prettier --check . --ignore-path ../../.prettierignore",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "test": "vitest run --project unit",
    "build:plugin-libs": "node scripts/build-plugin-libs.mjs",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.222",
