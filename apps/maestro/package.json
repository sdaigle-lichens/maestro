    "@tanstack/store": "~0.11.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "22.20.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser-playwright": "4.1.5",
    "@xyflow/react": "^12.11.0",
    "dagre": "^0.8.5",
    "electron": "^40.0.0",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.0",
    "playwright": "1.64.0",
