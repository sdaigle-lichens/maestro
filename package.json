{
  "name": "maestro-repo",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && eslint plugins/maestro/scripts",
    "check": "turbo run check && prettier --check plugins --ignore-path .prettierignore",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "pnpm lint && pnpm check && turbo run typecheck test",
    "refresh:runtime": "node scripts/refresh-runtime.mjs",
    "format": "turbo run format && prettier --write plugins --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "^9.39.0",
    "prettier": "^3.8.1",
    "turbo": "latest"
  }
}
